{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "extends": ["config:best-practices", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "pre-commit": {
    "enabled": true
  },
  "minimumReleaseAge": "30 days",
  "dependencyDashboard": false,
  "prConcurrentLimit": 1,
  "platformAutomerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "prPriority": -1
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "prPriority": 10
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "prPriority": 5
    },
    {
      "matchManagers": ["pre-commit"],
      "automerge": true,
      "prPriority": 4
    },
    {
      "matchManagers": ["pre-commit"],
      "matchPackageNames": ["https://github.com/golangci/golangci-lint"],
      "matchFileNames": [".pre-commit-config.yaml"],
      "allowedVersions": "v2.12.2",
      "automerge": false,
      "description": "keep golangci-lint aligned with the pinned Go 1.26.5 toolchain"
    },

    {
      "matchManagers": ["gomod"],
      "automerge": true,
      "prPriority": 3
    },
    {
      "matchManagers": ["npm"],
      "automerge": true,
      "prPriority": 2
    },
    {
      "matchManagers": ["cargo"],
      "automerge": true,
      "prPriority": 1
    },
    {
      "matchPackageNames": ["@chakra-ui/react"],
      "allowedVersions": "^2.0.0"
    },
    {
      "matchPackageNames": ["github.com/loft-sh/api/v4"],
      "allowedVersions": "v4.4.0"
    },
    {
      "matchPackageNames": ["github.com/tailscale/tailscale"],
      "allowedVersions": "v1.92.2"
    },
    {
      "matchPackageNames": ["gopkg.in/yaml.v2"],
      "allowedVersions": "v2.4.0"
    },
    {
      "matchPackageNames": ["@devsy/client"],
      "allowedVersions": "<=4.4.1"
    },
    {
      "matchPackageNames": [
        "actions/upload-artifact",
        "actions/download-artifact"
      ],
      "matchFileNames": [".github/workflows/act.yml"],
      "allowedVersions": "v4",
      "description": "pin to v4 for act support in act.yml workflow only"
    },
    {
      "matchPackageNames": ["ubuntu"],
      "matchManagers": ["github-actions"],
      "enabled": false,
      "description": "Do not automatically update Ubuntu runner versions"
    },
    {
      "matchPackageNames": ["vite"],
      "matchFileNames": ["desktop/**"],
      "allowedVersions": "<8.0.0",
      "description": "desktop: electron-vite 5 only supports vite <=7; unpin when electron-vite ships stable vite 8 support"
    },
    {
      "matchPackageNames": ["@sveltejs/vite-plugin-svelte"],
      "matchFileNames": ["desktop/**"],
      "allowedVersions": "<7.0.0",
      "description": "desktop: vite-plugin-svelte 7 requires vite 8, which electron-vite 5 rejects; unpin alongside vite 8"
    },
    {
      "matchPackageNames": ["typescript"],
      "matchFileNames": ["desktop/**"],
      "allowedVersions": "<7.0.0",
      "description": "desktop: typescript 7 crashes svelte-check 4; unpin when svelte-check supports TS 7"
    },
    {
      "matchPackageNames": ["svelte-check"],
      "matchFileNames": ["sites/images-devsy-sh/**"],
      "allowedVersions": "<4.7.4",
      "description": "images-devsy-sh: svelte-check 4.7.4 tightened its typescript peerDependency to ^5||^6, incompatible with typescript 7 used here; unpin when svelte-check supports TS 7"
    },
    {
      "matchPackageNames": ["typescript"],
      "matchFileNames": ["sites/docs-devsy-sh/**"],
      "allowedVersions": "<7.0.0",
      "description": "docs-devsy-sh: typescript 7 doesn't provide the compiler API Next.js's build-time type checking requires; unpin when Next.js supports TS 7"
    }
  ]
}
