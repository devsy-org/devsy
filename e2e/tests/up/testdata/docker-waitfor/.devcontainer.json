{
  "image": "ghcr.io/devsy-org/test-images/go:1",
  "waitFor": "updateContentCommand",
  "remoteEnv": {
    "CONTAINER_ENV_PATH": "${containerEnv:PATH}"
  },
  "onCreateCommand": "echo onCreateDone > on-create.out",
  "updateContentCommand": "echo updateContentDone > update-content.out",
  "postCreateCommand": "echo -n ${CONTAINER_ENV_PATH} > deferred-env-path.out && echo postCreateDone > deferred.marker",
  "postStartCommand": "echo postStartDone > post-start-deferred.out"
}
