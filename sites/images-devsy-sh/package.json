    "test": "vitest run",
    "check": "svelte-check --tsconfig tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.19.20",
    "jsdom": "29.1.1",
    "svelte": "5.56.4",
    "svelte-check": "4.6.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
